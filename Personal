    .about-bio p + p { margin-top: 1.5rem; }
    .about-bio strong { font-style: normal; font-weight: 400; color: var(--black); opacity: 1; }

    /* PHOTO STRIP */
    .photo-strip {
      padding: 0; display: grid; grid-template-columns: 2fr 1fr 1fr;
      height: 60vh; min-height: 300px;
      border-top: 0.5px solid var(--rule); border-bottom: 0.5px solid var(--rule);
    }
    .photo-item { position: relative; overflow: hidden; background: #141414; }
    .photo-item + .photo-item { border-left: 0.5px solid var(--rule); }
    .photo-item img {
      width: 100%; height: 100%; object-fit: cover; object-position: center;
      display: block; filter: grayscale(15%); transition: filter 0.5s, transform 0.6s;
    }
    .photo-item:hover img { filter: grayscale(0%); transform: scale(1.03); }
    .photo-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center;
      justify-content: center;
    }
    .photo-placeholder p {
      font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.18); text-align: center; line-height: 2;
    }
    .photo-label {
      position: absolute; bottom: 1.5rem; left: 1.5rem;
      font-size: 0.55rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: #fff; opacity: 0.9;
    }
    .photo-badge {
      position: absolute; top: 1.5rem; right: 1.5rem;
      font-size: 0.52rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: #fff; border: 0.5px solid rgba(255,255,255,0.4); padding: 0.3rem 0.65rem;
    }

    /* PILLARS */
    .pillar {
      display: grid; grid-template-columns: 56px 1fr;
      border-top: 0.5px solid var(--rule); padding: 3rem 0;
    }
    .pillar:last-child { border-bottom: 0.5px solid var(--rule); }
    .pillar-num {
      font-family: var(--serif); font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; opacity: 0.18; padding-top: 0.4rem;
    }
    .pillar-inner { display: grid; grid-template-columns: 1fr 1.65fr; gap: 3.5rem; align-items: start; }
    .pillar-label {
      font-size: 0.58rem; letter-spacing: 0.22em; text-transform: uppercase;
      opacity: 0.55; margin-bottom: 0.85rem; display: block;
    }
    .pillar-title {
      font-family: var(--serif); font-size: clamp(2rem, 3.2vw, 2.75rem);
      font-weight: 900; line-height: 0.95; letter-spacing: -0.02em;
