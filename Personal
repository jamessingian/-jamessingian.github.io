    .pillar-title em { font-style: italic; font-weight: 700; }
    .pillar-desc {
      font-family: var(--italic); font-size: 1.05rem; font-style: italic;
      font-weight: 300; line-height: 1.78; opacity: 0.88; margin-bottom: 1.75rem;
    }
    .pillar-audience { margin-bottom: 1.25rem; }
    .pillar-audience-label {
      font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase;
      opacity: 0.6; display: block; margin-bottom: 0.35rem;
    }
    .pillar-audience p { font-size: 0.82rem; line-height: 1.65; opacity: 0.75; }

    /* TESTIMONIALS */
    .testimonials { background: var(--black); color: #f0ede6; }
    .testimonials .section-rule { border-top-color: rgba(255,255,255,0.1); }
    .testimonials .section-label { color: #f0ede6; opacity: 0.25; }
    .testimonials .section-heading { color: #f0ede6; }
    .testi-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 3rem; }
    .testi-mark {
      font-family: var(--serif); font-size: 3.5rem; line-height: 0.8;
      opacity: 0.14; margin-bottom: 1rem; display: block;
    }
    .testi-quote {
      font-family: var(--italic); font-size: 0.98rem; font-style: italic;
      font-weight: 300; line-height: 1.78; opacity: 0.88; margin-bottom: 1.5rem;
    }
    .testi-name {
      font-family: var(--sans); font-size: 0.62rem; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: #f0ede6; opacity: 0.72; display: block; margin-bottom: 0.2rem;
    }
    .testi-role {
      font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;
      opacity: 0.55; color: #f0ede6;
    }

    /* CONTACT */
    .contact-inner { max-width: 600px; }
    .contact-tagline {
      font-family: var(--italic); font-size: 1.1rem; font-style: italic;
      font-weight: 300; opacity: 0.78; max-width: 480px; margin-bottom: 2.5rem; line-height: 1.72;
    }
    .contact-links { display: flex; gap: 2rem; flex-wrap: wrap; }
    .contact-link {
      font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--ink); text-decoration: none;
      border-bottom: 0.5px solid rgba(10,10,10,0.22);
      padding-bottom: 0.25rem; transition: opacity 0.2s;
    }
    .contact-link:hover { opacity: 0.4; }

    /* FOOTER */
    footer {
      padding: 1.75rem 3rem; border-top: 0.5px solid var(--rule);
      display: flex; justify-content: space-between; align-items: center;
      font-size: 0.58rem; letter-spacing: 0.15em; text-transform: uppercase; opacity: 0.28;
    }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      nav { padding: 1rem 1.5rem; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-text { padding: 3rem 1.5rem; }
      .hero-photo { height: 65vw; }
      .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .about-stats { flex-direction: row; flex-wrap: wrap; gap: 1.5rem; }
      .photo-strip { grid-template-columns: 1fr; height: auto; }
      .photo-item { height: 56vw; }
      .photo-item + .photo-item { border-left: none; border-top: 0.5px solid var(--rule); }
      .pillar { grid-template-columns: 36px 1fr; }
      .pillar-inner { grid-template-columns: 1fr; gap: 1.5rem; }
      .testi-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      section { padding: 4rem 1.5rem; }
    }
  </style>
</head>
