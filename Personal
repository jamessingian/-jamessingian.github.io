    }
    .hero-name {
      font-family: var(--serif);
      font-size: clamp(3.5rem, 5.5vw, 5.5rem);
      font-weight: 900; line-height: 0.92; letter-spacing: -0.02em; margin-bottom: 1.75rem;
    }
    .hero-name em { font-style: italic; font-weight: 700; }
    .hero-tagline {
      font-family: var(--italic); font-size: clamp(1rem, 1.6vw, 1.25rem);
      font-style: italic; font-weight: 300; line-height: 1.65;
      opacity: 0.82; max-width: 400px; margin-bottom: 2.5rem;
    }
    .hero-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 3rem; }
    .tag {
      font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase;
      border: 0.5px solid rgba(10,10,10,0.18); padding: 0.4rem 0.9rem;
      color: var(--ink); opacity: 0.8;
