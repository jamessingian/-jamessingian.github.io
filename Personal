    .hero-photo-caption {
      position: absolute; bottom: 2rem; right: 1.5rem;
      font-size: 0.55rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: #fff; opacity: 0.65;
    }

    /* SHARED */
    section { padding: 5.5rem 3rem; }
    .section-rule { width: 100%; border-top: 0.5px solid var(--rule); margin-bottom: 2.5rem; }
    .section-label {
      font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase;
      opacity: 0.55; margin-bottom: 0.4rem;
    }
    .section-heading {
